# Single FXS port: /dev/an7581-slic on PCM channel 0, slot 4.
# The AN7581 driver opens the PCM/SLIC devices directly; no line-card or
# port selection is exposed in the UI.

config voice 'config'
	option enabled '1'
	option protocol 'ims_sip'
	option test_mode 'echo'
	option line_name 'line1'
	option dial_timeout '60'
	option inbound '1'
	option fixed_number ''
	option dtmf_method 'RFC2833'
	option dtmf_payload '97'
	option clip_mode 'FSK'
	option flashhook_min '90'
	option flashhook_max '500'
	option hanging_reminder_tone_timer '40'
	option busy_tone_timer '40'
	option no_answer_timer '60'
	option codec_prefer_rule 'RemoteFirst'
	option fax_mode 'g711'
	option fax_negotiation 'all'
	option time_sync '0'
	option transmit_gain '0'
	option receive_gain '0'
	option echo_cancellation '1'

# The voice VLAN is operator/region specific and has no default. Leave it
# empty until the operator value is known; the page and voice-apply reject an
# empty VLAN when the voice network is enabled.
config network 'network'
	option enabled '0'
	option mode 'route'
	option uplink 'pon0'
	option name 'voice'
	option vlan_id ''
	option macaddr ''
	option proto 'dhcp'
	option ipaddr ''
	option netmask ''
	option gateway ''
	option dns ''

config sip 'sip'
	option register '1'
	option auth_username ''
	option auth_password ''
	option phone_number ''
	option proxy_server ''
	option proxy_port '5060'
	option proxy_transport 'udp'
	option register_server ''
	option register_port '5060'
	option register_transport 'udp'
	option outbound_server ''
	option outbound_port '5060'
	option standby_proxy_server ''
	option standby_proxy_port '5060'
	option standby_proxy_transport 'udp'
	option standby_register_server ''
	option standby_register_port '5060'
	option standby_register_transport 'udp'
	option standby_outbound_server ''
	option standby_outbound_port '5060'
	option signalling_dscp '0'
	option media_dscp '0'
	option heartbeat_enabled '0'
	option heartbeat_period '60'
	option heartbeat_timeout_count '3'
	option heartbeat_mode 'active'
	option register_period '3600'
	option register_retry_period '60'
	option session_update_period '30'
	option min_session_update_period '1'

config digitmap 'digitmap'
	option enabled '1'
	option match_mode 'max'
	option offhook_timer '15'
	option short_timer '5'
	option long_timer '16'
	option digit_map ''

config codec 'g711a'
	option codec 'G.711ALaw'
	option packetization '20'
	option priority '2'

config codec 'g722'
	option codec 'G.722'
	option packetization '20'
	option priority '1'

config codec 'g729'
	option codec 'G.729'
	option packetization '20'
	option priority '4'

config codec 'g711u'
	option codec 'G.711MuLaw'
	option packetization '20'
	option priority '3'

